# Modèle : copier en .env (ou générer avec new-env.ps1). Le fichier .env n'est jamais versionné.
TMS_DOMAIN=tms2m.com
ACME_EMAIL=
DB_PASSWORD=
TMS_ADMIN_USER=admin
TMS_ADMIN_PASSWORD=
TMS_ENROLLMENT_KEY=
TMS_AUTO_ACCEPT=true
TMS_POLL_INTERVAL=60
# Mise à jour automatique de TMS2M Agent (true/false)
TMS_AGENT_AUTO_UPDATE=true
