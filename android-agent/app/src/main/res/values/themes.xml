<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Charte TMS2M : bleu roi / cyan (logo S2M), en-tête anthracite portant le logo -->
    <style name="Theme.TmsAgent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/header_bg</item>
        <item name="colorAccent">@color/brand_mid</item>
        <item name="colorControlActivated">@color/brand_mid</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/brand_mid</item>
    </style>

    <!-- Bouton principal : dégradé de la marque -->
    <style name="BrandButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_brand</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
